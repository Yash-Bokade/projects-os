{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-right": ["tray", "pulseaudio", "battery", "clock"],

    "niri/workspaces": {
        "format": "{value}"
    },
    "niri/window": {
        "max-length": 60
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "{volume}% muted",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 20, "critical": 10 },
        "format": "{capacity}%",
        "format-charging": "{capacity}%+",
        "interval": 60
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y — week %V}",
        "interval": 60
    }
}

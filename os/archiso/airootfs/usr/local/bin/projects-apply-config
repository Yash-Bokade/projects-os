DEFAULT_SETTINGS = {
    "theme": "matte-dark",
    "font_size": 12,
    "default_session": "hyprland",
    "paths": {
        "projects_dir": str(HOME / "Projects"),
        "obs_recordings": str(HOME / "Exports" / "OBS"),
        "localsend_downloads": str(HOME / "Exports" / "LocalSend"),
        "backup_export": str(HOME / "Exports" / "Backups"),
    },
    "hotkeys": {
        "terminal": "Return",
        "launcher": "Space",
        "browser": "B",
        "neovim": "N",
        "sysmon": "S",
        "hide_all": "D",
        "shortcuts_menu": "Slash",
        "settings": "Comma",
        "localsend": "L",
        "obs": "O",
        "close_window": "Q",
        "project_reset": "Shift+R",
    },
}

def load_settings():
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    if not SETTINGS_FILE.exists():
        SETTINGS_FILE.write_text(json.dumps(DEFAULT_SETTINGS, indent=2), encoding="utf-8")
        return DEFAULT_SETTINGS
    data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    # Merge missing defaults cleanly
    merged = json.loads(json.dumps(DEFAULT_SETTINGS))
    merged.update({k: v for k, v in data.items() if k not in ("paths", "hotkeys")})
    merged["paths"].update(data.get("paths", {}))
    merged["hotkeys"].update(data.get("hotkeys", {}))
    return merged

def parse_hypr_bind(key_spec: str):
    if "+" in key_spec:
        parts = key_spec.split("+")
        mods = " ".join(["$mainMod"] + [p.upper() for p in parts[:-1]])
        key = parts[-1]
    else:
        mods = "$mainMod"
        key = key_spec
    key_map = {"Space": "space", "Slash": "slash", "Comma": "comma", "Return": "Return"}
    return mods, key_map.get(key, key)

def parse_niri_bind(key_spec: str):
    key_map = {"Slash": "Slash", "Comma": "Comma", "Space": "Space", "Return": "Return"}
    if "+" in key_spec:
        parts = key_spec.split("+")
        mods = "+".join(["Mod"] + parts[:-1])
        key = key_map.get(parts[-1], parts[-1])
        return f"{mods}+{key}"
    return f"Mod+{key_map.get(key_spec, key_spec)}"

def generate_shortcuts_txt(settings):
    hk = settings["hotkeys"]
    txt = f"""========================================================================
                       PROJECTS OS — SHORTCUTS GUIDE
        (Press Super + {hk['shortcuts_menu']} anytime for the interactive searchable menu)
========================================================================

[ SYSTEM & PERFORMANCE ]
  Super + {hk['sysmon']:<12}  Toggle System Monitor (btop — hidden by default)
  Super + {hk['hide_all']:<12}  Hide / Restore All Open Windows
  Super + {hk['shortcuts_menu']:<12}  Open Searchable Shortcuts Menu
  Super + {hk['settings']:<12}  Open Projects OS Settings GUI
  Super + {hk['project_reset']:<12}  Reset Current Project (keeps Wi-Fi, SSH, Settings)
  Super + {hk['close_window']:<12}  Close Focused Window
  Super + M             Exit Session (Return to Hyprland / Niri Switcher)

[ CORE APPLICATIONS ]
  Super + {hk['terminal']:<12}  Launch Terminal (Foot)
  Super + {hk['launcher']:<12}  Open Application Launcher (Fuzzel)
  Super + {hk['browser']:<12}  Launch Minimal Firefox
  Super + {hk['neovim']:<12}  Launch Neovim (LazyVim)
  Super + {hk['localsend']:<12}  Launch LocalSend (LAN File Sharing)
  Super + {hk['obs']:<12}  Launch OBS Studio

[ WORKSPACES & NAVIGATION (Hyprland & Niri) ]
  Super + 1..6          Switch Workspace 1-6
  Super + Shift + 1..6  Move Focused Window to Workspace 1-6
  Super + H/J/K/L       Focus Left / Down / Up / Right Window
  Super + Arrow Keys    Focus Window by Direction
  Super + F             Toggle Fullscreen
  Super + V             Toggle Floating Window (Hyprland) / Column Width (Niri)
  Print                 Region Screenshot to Clipboard (grim + slurp)

[ NEOVIM (LAZYVIM) ESSENTIALS ]
  Space                 Leader Key (opens Which-Key interactive help)
  Space + f + f         Find Files (Telescope / FzfLua)
  Space + s + g         Live Grep Across Project
  Space + e             Toggle File Explorer (Neo-tree)
  Space + g + g         Open LazyGit
  Space + c + a         Code Action (LSP)
  g + d                 Go to Definition
  K                     Hover Documentation
  Space + c + f         Format Buffer
  Space + l             Open Lazy Plugin Manager
  Space + c + m         Open Mason (LSP / Formatter Manager)
  Space + q + q         Quit Neovim

[ DATA EXPORT PATHS ]
  Projects Directory:   {settings['paths']['projects_dir']}
  OBS Recordings:       {settings['paths']['obs_recordings']}
  LocalSend Downloads:  {settings['paths']['localsend_downloads']}
  Backup Export Path:   {settings['paths']['backup_export']}
"""
    (HOME / "SHORTCUTS.txt").write_text(txt.lstrip("\n"), encoding="utf-8")

def write_hyprland_dynamic(settings, theme):
    hypr_dir = HOME / ".config" / "hypr"
    hypr_dir.mkdir(parents=True, exist_ok=True)
    hk = settings["hotkeys"]
    bg_hex = theme["bg"].lstrip("#")
    accent_hex = theme["accent"].lstrip("#")
    border_hex = theme["border"].lstrip("#")

    theme_conf = f"""# Auto-generated by Projects OS Settings
general {{
    col.active_border = rgb({accent_hex})
    col.inactive_border = rgb({border_hex})
}}
misc {{
    background_color = rgb({bg_hex})
    disable_hyprland_logo = true
    disable_splash_rendering = true
}}
"""
    (hypr_dir / "theme.conf").write_text(theme_conf, encoding="utf-8")

    binds = [
        ("terminal", "exec, foot"),
        ("launcher", "exec, fuzzel"),
        ("browser", "exec, firefox"),
        ("neovim", "exec, foot -e nvim"),
        ("sysmon", "exec, /usr/local/bin/projects-toggle-sysmon"),
        ("hide_all", "exec, /usr/local/bin/projects-toggle-hide-all"),
        ("shortcuts_menu", "exec, /usr/local/bin/projects-shortcuts-menu"),
        ("settings", "exec, /usr/local/bin/projects-settings"),
        ("localsend", "exec, /usr/local/bin/localsend"),
        ("obs", "exec, obs"),
        ("close_window", "killactive,"),
        ("project_reset", "exec, /usr/local/bin/projects-reset"),
    ]
    lines = ["# Auto-generated by Projects OS Settings", "$mainMod = SUPER"]
    for name, action in binds:
        mods, key = parse_hypr_bind(hk[name])
        lines.append(f"bind = {mods}, {key}, {action}")
    (hypr_dir / "keybinds.conf").write_text("\n".join(lines) + "\n", encoding="utf-8")

def write_niri_config(settings, theme):
    niri_dir = HOME / ".config" / "niri"
    niri_dir.mkdir(parents=True, exist_ok=True)
    hk = settings["hotkeys"]
    cfg = f"""// Auto-generated by Projects OS Settings (Niri)
input {{
    keyboard {{
        xkb {{
            layout "us"
        }}
    }}
    touchpad {{
        tap
        natural-scroll
        dwt
    }}
}}

layout {{
    gaps 8
    center-focused-column "never"
    preset-column-widths {{
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }}
    focus-ring {{
        width 2
        active-color "{theme['accent']}"
        inactive-color "{theme['border']}"
    }}
    background-color "{theme['bg']}"
}}

prefer-no-csd

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "/usr/local/bin/projects-firstboot-hook"

environment {{
    DISPLAY ":0"
    MOZ_ENABLE_WAYLAND "1"
    QT_QPA_PLATFORM "wayland"
}}

window-rule {{
    match app-id="^projects-sysmon$"
    open-floating true
    default-column-width {{ proportion 0.78; }}
    default-window-height {{ proportion 0.75; }}
}}

window-rule {{
    match app-id="^org\.projectsos\.(settings|wizard)$"
    open-floating true
}}

binds {{
    {parse_niri_bind(hk['terminal'])} {{ spawn "foot"; }}
    {parse_niri_bind(hk['launcher'])} {{ spawn "fuzzel"; }}
    {parse_niri_bind(hk['browser'])} {{ spawn "firefox"; }}
    {parse_niri_bind(hk['neovim'])} {{ spawn "foot" "-e" "nvim"; }}
    {parse_niri_bind(hk['sysmon'])} {{ spawn "/usr/local/bin/projects-toggle-sysmon"; }}
    {parse_niri_bind(hk['hide_all'])} {{ spawn "/usr/local/bin/projects-toggle-hide-all"; }}
    {parse_niri_bind(hk['shortcuts_menu'])} {{ spawn "/usr/local/bin/projects-shortcuts-menu"; }}
    {parse_niri_bind(hk['settings'])} {{ spawn "/usr/local/bin/projects-settings"; }}
    {parse_niri_bind(hk['localsend'])} {{ spawn "/usr/local/bin/localsend"; }}
    {parse_niri_bind(hk['obs'])} {{ spawn "obs"; }}
    {parse_niri_bind(hk['project_reset'])} {{ spawn "/usr/local/bin/projects-reset"; }}
    {parse_niri_bind(hk['close_window'])} {{ close-window; }}

    Mod+H {{ focus-column-left; }}
    Mod+L {{ focus-column-right; }}
    Mod+J {{ focus-window-down; }}
    Mod+K {{ focus-window-up; }}
    Mod+Left {{ focus-column-left; }}
    Mod+Right {{ focus-column-right; }}
    Mod+Down {{ focus-window-down; }}
    Mod+Up {{ focus-window-up; }}

    Mod+F {{ maximize-column; }}
    Mod+V {{ switch-preset-column-width; }}
    Mod+M {{ quit; }}

    Mod+1 {{ focus-workspace 1; }}
    Mod+2 {{ focus-workspace 2; }}
    Mod+3 {{ focus-workspace 3; }}
    Mod+4 {{ focus-workspace 4; }}
    Mod+5 {{ focus-workspace 5; }}
    Mod+6 {{ focus-workspace 6; }}

    Mod+Shift+1 {{ move-column-to-workspace 1; }}
    Mod+Shift+2 {{ move-column-to-workspace 2; }}
    Mod+Shift+3 {{ move-column-to-workspace 3; }}
    Mod+Shift+4 {{ move-column-to-workspace 4; }}
    Mod+Shift+5 {{ move-column-to-workspace 5; }}
    Mod+Shift+6 {{ move-column-to-workspace 6; }}

    Print {{ screenshot; }}
    XF86AudioRaiseVolume allow-when-locked=true {{ spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }}
    XF86AudioLowerVolume allow-when-locked=true {{ spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }}
    XF86AudioMute allow-when-locked=true {{ spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }}
    XF86MonBrightnessUp allow-when-locked=true {{ spawn "brightnessctl" "set" "5%+"; }}
    XF86MonBrightnessDown allow-when-locked=true {{ spawn "brightnessctl" "set" "5%-"; }}
}}
"""
    (niri_dir / "config.kdl").write_text(cfg, encoding="utf-8")

def write_waybar_style(settings, theme):
    wb_dir = HOME / ".config" / "waybar"
    wb_dir.mkdir(parents=True, exist_ok=True)
    fs = settings.get("font_size", 12)
    css = f"""* {{
  font-family: "JetBrainsMono Nerd Font", "Inter", monospace;
  font-size: {fs}px;
  border: none;
  border-radius: 0;
  min-height: 0;
}}

window#waybar {{
  background-color: {theme['surface']};
  color: {theme['fg']};
  border-bottom: 1px solid {theme['border']};
}}

#workspaces button, #custom-session, #cpu, #memory, #custom-storage,
#network, #battery, #clock, #custom-settings, #custom-reset {{
  padding: 2px 10px;
  color: {theme['fg']};
}}

#workspaces button.active, #workspaces button.focused {{
  color: {theme['accent']};
  border-bottom: 2px solid {theme['accent']};
}}

#cpu, #memory, #custom-storage {{
  color: {theme['accent']};
  font-weight: 600;
}}

#custom-reset {{
  color: {theme['danger']};
  font-weight: 600;
}}

#custom-settings:hover, #custom-reset:hover {{
  background-color: {theme['border']};
}}
"""
    (wb_dir / "style.css").write_text(css, encoding="utf-8")

def write_foot_and_fuzzel(settings, theme):
    foot_dir = HOME / ".config" / "foot"
    foot_dir.mkdir(parents=True, exist_ok=True)
    fs = settings.get("font_size", 12)
    bg = theme["bg"].lstrip("#")
    fg = theme["fg"].lstrip("#")
    foot_ini = f"""[main]
font=JetBrainsMono Nerd Font:size={fs}
pad=10x10

[colors]
background={bg}
foreground={fg}
"""
    (foot_dir / "foot.ini").write_text(foot_ini, encoding="utf-8")

    fuzz_dir = HOME / ".config" / "fuzzel"
    fuzz_dir.mkdir(parents=True, exist_ok=True)
    fuzz_ini = f"""[main]
font=JetBrainsMono Nerd Font:size={fs}
prompt="❯ "
width=45
lines=12
horizontal-pad=16
vertical-pad=12

[colors]
background={theme['surface'].lstrip('#')}ff
text={theme['fg'].lstrip('#')}ff
match={theme['accent'].lstrip('#')}ff
selection={theme['border'].lstrip('#')}ff
selection-text={theme['fg'].lstrip('#')}ff
border={theme['accent'].lstrip('#')}ff

[border]
width=2
radius=6
"""
    (fuzz_dir / "fuzzel.ini").write_text(fuzz_ini, encoding="utf-8")

def sync_export_paths(settings):
    paths = settings["paths"]
    for p in paths.values():
        Path(os.path.expanduser(p)).mkdir(parents=True, exist_ok=True)

    # Sync OBS default recording path
    obs_profile = HOME / ".config" / "obs-studio" / "basic" / "profiles" / "ProjectsOS"
    obs_profile.mkdir(parents=True, exist_ok=True)
    obs_ini = obs_profile / "basic.ini"
    obs_content = f"""[General]
Name=ProjectsOS

[SimpleOutput]
FilePath={os.path.expanduser(paths['obs_recordings'])}
RecFormat2=mkv
VBitrate=4500

[AdvOut]
RecFilePath={os.path.expanduser(paths['obs_recordings'])}
"""
    obs_ini.write_text(obs_content, encoding="utf-8")

    # Sync LocalSend download destination
    ls_dir = HOME / ".local" / "share" / "org.localsend.localsend_app"
    ls_dir.mkdir(parents=True, exist_ok=True)
    ls_prefs_file = ls_dir / "shared_preferences.json"
    prefs = {}
    if ls_prefs_file.exists():
        try:
            prefs = json.loads(ls_prefs_file.read_text(encoding="utf-8"))
        except Exception:
            prefs = {}
    prefs["flutter.ls_destination"] = os.path.expanduser(paths["localsend_downloads"])
    ls_prefs_file.write_text(json.dumps(prefs, indent=2), encoding="utf-8")

def reload_live_components():
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Restart waybar cleanly if running
    if subprocess.run(["pgrep", "-x", "waybar"], stdout=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)

def main():
    settings = load_settings()
    theme = THEMES.get(settings.get("theme", "matte-dark"), THEMES["matte-dark"])
    generate_shortcuts_txt(settings)
    write_hyprland_dynamic(settings, theme)
    write_niri_config(settings, theme)
    write_waybar_style(settings, theme)
    write_foot_and_fuzzel(settings, theme)
    sync_export_paths(settings)
    reload_live_components()

if __name__ == "__main__":
    main()

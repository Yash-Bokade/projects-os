#!/usr/bin/env bash
# Projects OS — Unified Config Sync Engine (100% Pure Bash + jq — Zero Python)
set -euo pipefail

CFG_DIR="$HOME/.config/projects-os"
CONF_FILE="$CFG_DIR/settings.conf"
mkdir -p "$CFG_DIR"

if [[ ! -f "$CONF_FILE" ]]; then
  cat > "$CONF_FILE" <<EOF
[general]
theme=matte-dark
font_size=12
default_session=hyprland

[paths]
projects_dir=$HOME/Projects
obs_recordings=$HOME/Exports/OBS
localsend_downloads=$HOME/Exports/LocalSend
backup_export=$HOME/Exports/Backups

[hotkeys]
terminal=Return
launcher=Space
browser=B
neovim=N
sysmon=S
hide_all=D
shortcuts_menu=Slash
settings=Comma
localsend=L
obs=O
close_window=Q
project_reset=Shift+R
EOF
fi

ini_get() {
  local sec="$1" key="$2" def="$3" val
  val=$(awk -F'=' -v s="[$sec]" -v k="$key" '
    $0 == s { in_s = 1; next }
    /^\[/ { in_s = 0 }
    in_s && $1 == k { sub(/^[^=]*=/, ""); print; exit }
  ' "$CONF_FILE" 2>/dev/null || true)
  if [[ -n "$val" ]]; then
    printf '%s' "$val"
  else
    printf '%s' "$def"
  fi
}

expand_tilde() {
  local p="$1"
  printf '%s' "${p/#\~/$HOME}"
}

THEME=$(ini_get general theme "matte-dark")
FONT_SIZE=$(ini_get general font_size "12")

PROJECTS_DIR=$(expand_tilde "$(ini_get paths projects_dir "$HOME/Projects")")
OBS_DIR=$(expand_tilde "$(ini_get paths obs_recordings "$HOME/Exports/OBS")")
LOCALSEND_DIR=$(expand_tilde "$(ini_get paths localsend_downloads "$HOME/Exports/LocalSend")")
BACKUP_DIR=$(expand_tilde "$(ini_get paths backup_export "$HOME/Exports/Backups")")

HK_TERM=$(ini_get hotkeys terminal "Return")
HK_LAUNCH=$(ini_get hotkeys launcher "Space")
HK_BROWSER=$(ini_get hotkeys browser "B")
HK_NVIM=$(ini_get hotkeys neovim "N")
HK_SYSMON=$(ini_get hotkeys sysmon "S")
HK_HIDE=$(ini_get hotkeys hide_all "D")
HK_MENU=$(ini_get hotkeys shortcuts_menu "Slash")
HK_SETTINGS=$(ini_get hotkeys settings "Comma")
HK_LS=$(ini_get hotkeys localsend "L")
HK_OBS=$(ini_get hotkeys obs "O")
HK_CLOSE=$(ini_get hotkeys close_window "Q")
HK_RESET=$(ini_get hotkeys project_reset "Shift+R")

case "$THEME" in
  carbon-slate)
    BG="#121212"; SURFACE="#1c1c1e"; BORDER="#333336"
    ACCENT="#34d399"; FG="#f3f4f6"; DANGER="#ef4444"
    ;;
  nord-minimal)
    BG="#1f2430"; SURFACE="#282e3c"; BORDER="#3b4252"
    ACCENT="#88c0d0"; FG="#eceff4"; DANGER="#bf616a"
    ;;
  matte-light)
    BG="#f4f5f7"; SURFACE="#ffffff"; BORDER="#d0d7de"
    ACCENT="#0969da"; FG="#1f2328"; DANGER="#cf222e"
    ;;
  *)
    BG="#0e1014"; SURFACE="#161920"; BORDER="#2a303c"
    ACCENT="#6ea8fe"; FG="#e6edf3"; DANGER="#f85149"
    ;;
esac

BG_HEX="${BG#\#}"
SURFACE_HEX="${SURFACE#\#}"
BORDER_HEX="${BORDER#\#}"
ACCENT_HEX="${ACCENT#\#}"
FG_HEX="${FG#\#}"

hypr_bind_line() {
  local spec="$1" action="$2" mods='$mainMod'
  local key="$spec"
  if [[ "$spec" == *"+"* ]]; then
    key="${spec##*+}"
    local prefix="${spec%+*}"
    local up_mods="${prefix//+/ }"
    mods="\$mainMod ${up_mods^^}"
  fi
  case "$key" in
    Space)  key="space" ;;
    Slash)  key="slash" ;;
    Comma)  key="comma" ;;
    Return) key="Return" ;;
  esac
  printf 'bind = %s, %s, %s\n' "$mods" "$key" "$action"
}

niri_key() {
  local spec="$1"
  printf 'Mod+%s' "$spec"
}

# 1. Generate ~/SHORTCUTS.txt
cat > "$HOME/SHORTCUTS.txt" <<EOF
========================================================================
                       PROJECTS OS — SHORTCUTS GUIDE
        (Press Super + ${HK_MENU} anytime for the interactive searchable menu)
========================================================================

[ SYSTEM & PERFORMANCE ]
  Super + $(printf '%-12s' "$HK_SYSMON")  Toggle System Monitor (btop — hidden by default)
  Super + $(printf '%-12s' "$HK_HIDE")  Hide / Restore All Open Windows
  Super + $(printf '%-12s' "$HK_MENU")  Open Searchable Shortcuts Menu
  Super + $(printf '%-12s' "$HK_SETTINGS")  Open Projects OS Settings GUI
  Super + $(printf '%-12s' "$HK_RESET")  Reset Current Project (keeps Wi-Fi, SSH, Settings)
  Super + $(printf '%-12s' "$HK_CLOSE")  Close Focused Window
  Super + M             Exit Session (Return to Hyprland / Niri Switcher)

[ CORE APPLICATIONS ]
  Super + $(printf '%-12s' "$HK_TERM")  Launch Terminal (Foot)
  Super + $(printf '%-12s' "$HK_LAUNCH")  Open Application Launcher (Fuzzel)
  Super + $(printf '%-12s' "$HK_BROWSER")  Launch Minimal Firefox
  Super + $(printf '%-12s' "$HK_NVIM")  Launch Neovim (LazyVim)
  Super + $(printf '%-12s' "$HK_LS")  Launch LocalSend (LAN File Sharing)
  Super + $(printf '%-12s' "$HK_OBS")  Launch OBS Studio

[ WORKSPACES & NAVIGATION (Hyprland & Niri) ]
  Super + 1..6          Switch Workspace 1-6
  Super + Shift + 1..6  Move Focused Window to Workspace 1-6
  Super + H/J/K/L       Focus Left / Down / Up / Right Window
  Super + Arrow Keys    Focus Window by Direction
  Super + F             Toggle Fullscreen
  Super + V             Toggle Floating Window (Hyprland) / Column Width (Niri)
  Print                 Region Screenshot to Clipboard (grim + slurp)

[ NEOVIM (LAZYVIM) ESSENTIALS ]
  Space                 Leader Key (opens Which-Key interactive help)
  Space + f + f         Find Files (Telescope / FzfLua)
  Space + s + g         Live Grep Across Project
  Space + e             Toggle File Explorer (Neo-tree)
  Space + g + g         Open LazyGit
  Space + c + a         Code Action (LSP)
  g + d                 Go to Definition
  K                     Hover Documentation
  Space + c + f         Format Buffer
  Space + l             Open Lazy Plugin Manager
  Space + c + m         Open Mason (LSP / Formatter Manager)
  Space + q + q         Quit Neovim

[ DATA EXPORT PATHS ]
  Projects Directory:   ${PROJECTS_DIR}
  OBS Recordings:       ${OBS_DIR}
  LocalSend Downloads:  ${LOCALSEND_DIR}
  Backup Export Path:   ${BACKUP_DIR}
EOF

# 2. Generate Hyprland dynamic theme & keybinds
mkdir -p "$HOME/.config/hypr"
cat > "$HOME/.config/hypr/theme.conf" <<EOF
# Auto-generated by Projects OS Settings (Pure Bash)
general {
    col.active_border = rgb(${ACCENT_HEX})
    col.inactive_border = rgb(${BORDER_HEX})
}
misc {
    background_color = rgb(${BG_HEX})
    disable_hyprland_logo = true
    disable_splash_rendering = true
}
EOF

{
  echo "# Auto-generated by Projects OS Settings (Pure Bash)"
  echo '$mainMod = SUPER'
  hypr_bind_line "$HK_TERM"     "exec, foot"
  hypr_bind_line "$HK_LAUNCH"   "exec, fuzzel"
  hypr_bind_line "$HK_BROWSER"  "exec, firefox"
  hypr_bind_line "$HK_NVIM"     "exec, foot -e nvim"
  hypr_bind_line "$HK_SYSMON"   "exec, /usr/local/bin/projects-toggle-sysmon"
  hypr_bind_line "$HK_HIDE"     "exec, /usr/local/bin/projects-toggle-hide-all"
  hypr_bind_line "$HK_MENU"     "exec, /usr/local/bin/projects-shortcuts-menu"
  hypr_bind_line "$HK_SETTINGS" "exec, /usr/local/bin/projects-settings"
  hypr_bind_line "$HK_LS"       "exec, /usr/local/bin/localsend"
  hypr_bind_line "$HK_OBS"      "exec, obs"
  hypr_bind_line "$HK_CLOSE"    "killactive,"
  hypr_bind_line "$HK_RESET"    "exec, /usr/local/bin/projects-reset"
} > "$HOME/.config/hypr/keybinds.conf"

# 3. Generate Niri config.kdl
mkdir -p "$HOME/.config/niri"
cat > "$HOME/.config/niri/config.kdl" <<EOF
// Auto-generated by Projects OS Settings (Niri)
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring {
        width 2
        active-color "${ACCENT}"
        inactive-color "${BORDER}"
    }
    background-color "${BG}"
}

prefer-no-csd

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "/usr/local/bin/projects-firstboot-hook"

environment {
    DISPLAY ":0"
    MOZ_ENABLE_WAYLAND "1"
    QT_QPA_PLATFORM "wayland"
}

window-rule {
    match app-id="^projects-sysmon$"
    open-floating true
    default-column-width { proportion 0.78; }
    default-window-height { proportion 0.75; }
}

window-rule {
    match app-id="^org\\.projectsos\\.(settings|wizard)$"
    open-floating true
}

binds {
    $(niri_key "$HK_TERM") { spawn "foot"; }
    $(niri_key "$HK_LAUNCH") { spawn "fuzzel"; }
    $(niri_key "$HK_BROWSER") { spawn "firefox"; }
    $(niri_key "$HK_NVIM") { spawn "foot" "-e" "nvim"; }
    $(niri_key "$HK_SYSMON") { spawn "/usr/local/bin/projects-toggle-sysmon"; }
    $(niri_key "$HK_HIDE") { spawn "/usr/local/bin/projects-toggle-hide-all"; }
    $(niri_key "$HK_MENU") { spawn "/usr/local/bin/projects-shortcuts-menu"; }
    $(niri_key "$HK_SETTINGS") { spawn "/usr/local/bin/projects-settings"; }
    $(niri_key "$HK_LS") { spawn "/usr/local/bin/localsend"; }
    $(niri_key "$HK_OBS") { spawn "obs"; }
    $(niri_key "$HK_RESET") { spawn "/usr/local/bin/projects-reset"; }
    $(niri_key "$HK_CLOSE") { close-window; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    Mod+F { maximize-column; }
    Mod+V { switch-preset-column-width; }
    Mod+M { quit; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }

    Print { screenshot; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}
EOF

# 4. Generate Waybar style.css
mkdir -p "$HOME/.config/waybar"
cat > "$HOME/.config/waybar/style.css" <<EOF
* {
  font-family: "JetBrainsMono Nerd Font", "Inter", monospace;
  font-size: ${FONT_SIZE}px;
  border: none;
  border-radius: 0;
  min-height: 0;
}

window#waybar {
  background-color: ${SURFACE};
  color: ${FG};
  border-bottom: 1px solid ${BORDER};
}

#workspaces button, #custom-session, #cpu, #memory, #custom-storage,
#network, #battery, #clock, #custom-settings, #custom-reset {
  padding: 2px 10px;
  color: ${FG};
}

#workspaces button.active, #workspaces button.focused {
  color: ${ACCENT};
  border-bottom: 2px solid ${ACCENT};
}

#cpu, #memory, #custom-storage {
  color: ${ACCENT};
  font-weight: 600;
}

#custom-reset {
  color: ${DANGER};
  font-weight: 600;
}

#custom-settings:hover, #custom-reset:hover {
  background-color: ${BORDER};
}
EOF

# 5. Generate Foot & Fuzzel configs
mkdir -p "$HOME/.config/foot" "$HOME/.config/fuzzel"
cat > "$HOME/.config/foot/foot.ini" <<EOF
[main]
font=JetBrainsMono Nerd Font:size=${FONT_SIZE}
pad=10x10

[colors]
background=${BG_HEX}
foreground=${FG_HEX}
EOF

cat > "$HOME/.config/fuzzel/fuzzel.ini" <<EOF
[main]
font=JetBrainsMono Nerd Font:size=${FONT_SIZE}
prompt="❯ "
width=45
lines=12
horizontal-pad=16
vertical-pad=12

[colors]
background=${SURFACE_HEX}ff
text=${FG_HEX}ff
match=${ACCENT_HEX}ff
selection=${BORDER_HEX}ff
selection-text=${FG_HEX}ff
border=${ACCENT_HEX}ff

[border]
width=2
radius=6
EOF

# 6. Sync Data Export Paths (OBS + LocalSend)
mkdir -p "$PROJECTS_DIR" "$OBS_DIR" "$LOCALSEND_DIR" "$BACKUP_DIR"

OBS_PROF="$HOME/.config/obs-studio/basic/profiles/ProjectsOS"
mkdir -p "$OBS_PROF"
cat > "$OBS_PROF/basic.ini" <<EOF
[General]
Name=ProjectsOS

[SimpleOutput]
FilePath=${OBS_DIR}
RecFormat2=mkv
VBitrate=4500

[AdvOut]
RecFilePath=${OBS_DIR}
EOF

LS_DIR="$HOME/.local/share/org.localsend.localsend_app"
LS_PREFS="$LS_DIR/shared_preferences.json"
mkdir -p "$LS_DIR"
if command -v jq >/dev/null 2>&1; then
  if [[ -s "$LS_PREFS" ]] && jq empty "$LS_PREFS" >/dev/null 2>&1; then
    jq --arg dest "$LOCALSEND_DIR" '.["flutter.ls_destination"] = $dest' "$LS_PREFS" > "$LS_PREFS.tmp"
    mv "$LS_PREFS.tmp" "$LS_PREFS"
  else
    jq -n --arg dest "$LOCALSEND_DIR" '{"flutter.ls_destination": $dest}' > "$LS_PREFS"
  fi
else
  ESCAPED_DIR="${LOCALSEND_DIR//\"/\\\"}"
  printf '{"flutter.ls_destination":"%s"}\n' "$ESCAPED_DIR" > "$LS_PREFS"
fi

# 7. Reload live Wayland session components if active
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  hyprctl reload >/dev/null 2>&1 || true
fi
if pgrep -x waybar >/dev/null 2>&1; then
  pkill -SIGUSR2 waybar || true
fi

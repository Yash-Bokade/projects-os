#!/usr/bin/env bash
if mountpoint -q /persist; then
  TARGET="/persist"
  LABEL="USB"
else
  TARGET="/"
  LABEL="RAM"
fi
AVAIL=$(df -BG --output=avail "$TARGET" | tail -n 1 | tr -dc '0-9')
TOTAL=$(df -BG --output=size "$TARGET" | tail -n 1 | tr -dc '0-9')
USED_PCT=$(df --output=pcent "$TARGET" | tail -n 1 | tr -dc '0-9')
printf '{"text":"SSD %sG free","tooltip":"%s Persistence: %s GB free of %s GB (%s%% used)"}\n' \
  "$AVAIL" "$LABEL" "$AVAIL" "$TOTAL" "$USED_PCT"

#!/usr/bin/env python3
import json
import os
import subprocess
import threading
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib

HOME = Path.home()
STATE_DIR = HOME / ".local" / "state" / "projects-os"
WIZARD_DONE = STATE_DIR / "wizard-done"
LAZYVIM_JSON = HOME / ".config" / "nvim" / "lazyvim.json"

STACKS = [
    ("java",   "Java (Latest OpenJDK)",     "mise", "java@latest",   "lazyvim.plugins.extras.lang.java"),
    ("rust",   "Rust (Latest Toolchain)",   "mise", "rust@latest",   "lazyvim.plugins.extras.lang.rust"),
    ("go",     "Go (Latest Release)",       "mise", "go@latest",     "lazyvim.plugins.extras.lang.go"),
    ("node",   "Node.js + TypeScript",      "mise", "node@latest",   "lazyvim.plugins.extras.lang.typescript"),
    ("python", "Python (Latest 3.x)",       "mise", "python@latest", "lazyvim.plugins.extras.lang.python"),
    ("cpp",    "C / C++ (Clang + CMake)",   "pacman", "clang cmake ninja gdb lldb", "lazyvim.plugins.extras.lang.clangd"),
    ("zig",    "Zig (Latest)",              "mise", "zig@latest",    "lazyvim.plugins.extras.lang.zig"),
    ("bun",    "Bun (Latest JS Runtime)",   "mise", "bun@latest",    "lazyvim.plugins.extras.lang.typescript"),
]

class WizardApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.projectsos.wizard")
        self.checkboxes = {}

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, title="Projects OS — Project Setup Wizard")
        win.set_default_size(680, 580)
        win.set_resizable(False)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_margin_top(22)
        root.set_margin_bottom(22)
        root.set_margin_start(24)
        root.set_margin_end(24)
        win.set_child(root)

        title = Gtk.Label(label="Welcome to Projects OS")
        title.set_xalign(0)
        title.add_css_class("title-1")
        root.append(title)

        subtitle = Gtk.Label(
            label="Step 1: Verify internet connectivity. Step 2: Pick the languages for your project.\n"
                  "Latest versions will be installed and wired directly into Neovim (LazyVim)."
        )
        subtitle.set_xalign(0)
        subtitle.set_wrap(True)
        root.append(subtitle)

        # --- Step 1: Network Card ---
        net_frame = Gtk.Frame(label=" 1. Internet Connectivity ")
        net_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        net_box.set_margin_top(10)
        net_box.set_margin_bottom(10)
        net_box.set_margin_start(12)
        net_box.set_margin_end(12)
        net_frame.set_child(net_box)

        self.net_status = Gtk.Label(label="Checking internet connection...")
        self.net_status.set_hexpand(True)
        self.net_status.set_xalign(0)
        net_box.append(self.net_status)

        wifi_btn = Gtk.Button(label="Connect Wi-Fi / Ethernet")
        wifi_btn.connect("clicked", self.on_open_nmtui)
        net_box.append(wifi_btn)

        recheck_btn = Gtk.Button(label="Recheck")
        recheck_btn.connect("clicked", lambda *_: self.check_internet())
        net_box.append(recheck_btn)
        root.append(net_frame)

        # --- Step 2: Language Stack Picker ---
        stack_frame = Gtk.Frame(label=" 2. Select Project Language Stack(s) ")
        grid = Gtk.Grid(column_spacing=18, row_spacing=8)
        grid.set_margin_top(10)
        grid.set_margin_bottom(10)
        grid.set_margin_start(12)
        grid.set_margin_end(12)
        stack_frame.set_child(grid)

        for idx, (key, label, *_rest) in enumerate(STACKS):
            cb = Gtk.CheckButton(label=label)
            self.checkboxes[key] = cb
            grid.attach(cb, idx % 2, idx // 2, 1, 1)

        custom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        custom_box.set_margin_top(8)
        custom_lbl = Gtk.Label(label="Extra mise tools (optional, space-separated):")
        self.custom_entry = Gtk.Entry()
        self.custom_entry.set_placeholder_text("e.g. deno@latest kotlin@latest")
        self.custom_entry.set_hexpand(True)
        custom_box.append(custom_lbl)
        custom_box.append(self.custom_entry)

        stack_outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        stack_outer.append(grid)
        stack_outer.append(custom_box)
        stack_frame.set_child(stack_outer)
        root.append(stack_frame)

        # --- Step 3: Live Progress Log ---
        self.log_buf = Gtk.TextBuffer()
        log_view = Gtk.TextView(buffer=self.log_buf, editable=False, monospace=True)
        log_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_min_content_height(130)
        scrolled.set_vexpand(True)
        scrolled.set_child(log_view)
        root.append(scrolled)

        # --- Action Buttons ---
        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_row.set_halign(Gtk.Align.END)

        skip_btn = Gtk.Button(label="Skip for Now")
        skip_btn.connect("clicked", lambda *_: self.finish_wizard(win))
        btn_row.append(skip_btn)

        self.install_btn = Gtk.Button(label="Install Stack & Launch Desktop")
        self.install_btn.add_css_class("suggested-action")
        self.install_btn.connect("clicked", lambda *_: self.start_install(win))
        btn_row.append(self.install_btn)
        root.append(btn_row)

        self.check_internet()
        win.present()

    def append_log(self, text: str):
        def _do():
            end = self.log_buf.get_end_iter()
            self.log_buf.insert(end, text + "\n")
            return False
        GLib.idle_add(_do)

    def check_internet(self):
        def _worker():
            ok = subprocess.run(
                ["curl", "-fsS", "--max-time", "4", "https://archlinux.org"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ).returncode == 0
            msg = "Online — Ready to install latest toolchains." if ok else "Offline — Connect Wi-Fi or plug in Ethernet."
            GLib.idle_add(self.net_status.set_text, msg)
        threading.Thread(target=_worker, daemon=True).start()

    def on_open_nmtui(self, _btn):
        subprocess.Popen(["foot", "--title=Network Setup", "-e", "nmtui"])

    def start_install(self, win):
        selected = [s for s in STACKS if self.checkboxes[s[0]].get_active()]
        extra_tools = [t.strip() for t in self.custom_entry.get_text().split() if t.strip()]

        if not selected and not extra_tools:
            self.finish_wizard(win)
            return

        self.install_btn.set_sensitive(False)
        threading.Thread(target=self._run_install, args=(selected, extra_tools, win), daemon=True).start()

    def _run_cmd(self, cmd):
        self.append_log(f"$ {' '.join(cmd)}")
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            self.append_log(line.rstrip())
        proc.wait()
        return proc.returncode

    def _run_install(self, selected, extra_tools, win):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        extras = set()
        pacman_pkgs = []

        for key, label, method, spec, nvim_extra in selected:
            self.append_log(f"==> Installing {label}...")
            if method == "mise":
                self._run_cmd(["mise", "use", "-g", spec])
            elif method == "pacman":
                pkgs = spec.split()
                pacman_pkgs.extend(pkgs)
                self._run_cmd(["sudo", "pacman", "-Sy", "--noconfirm", "--needed"] + pkgs)
            if nvim_extra:
                extras.add(nvim_extra)

        for tool in extra_tools:
            self.append_log(f"==> Installing extra tool: {tool}...")
            self._run_cmd(["mise", "use", "-g", tool])

        if pacman_pkgs:
            (STATE_DIR / "pacman-stacks.list").write_text("\n".join(sorted(set(pacman_pkgs))) + "\n", encoding="utf-8")

        # Enable LazyVim language extras automatically
        if extras:
            self.append_log("==> Wiring selected languages into Neovim (LazyVim)...")
            LAZYVIM_JSON.parent.mkdir(parents=True, exist_ok=True)
            cfg = {"extras": sorted(extras), "version": 7}
            if LAZYVIM_JSON.exists():
                try:
                    existing = json.loads(LAZYVIM_JSON.read_text(encoding="utf-8"))
                    cfg["extras"] = sorted(set(existing.get("extras", [])) | extras)
                except Exception:
                    pass
            LAZYVIM_JSON.write_text(json.dumps(cfg, indent=2), encoding="utf-8")
            self._run_cmd(["nvim", "--headless", "+Lazy! sync", "+qa"])

        self.append_log("\nAll selected stacks are installed and ready in Neovim!")
        GLib.idle_add(self.finish_wizard, win)

    def finish_wizard(self, win):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        WIZARD_DONE.write_text("completed\n", encoding="utf-8")
        subprocess.run(["notify-send", "Projects OS Ready", "Your project environment is configured."], check=False)
        win.close()

if __name__ == "__main__":
    app = WizardApp()
    app.run()

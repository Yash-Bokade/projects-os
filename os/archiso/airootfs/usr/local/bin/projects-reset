#!/usr/bin/env bash
# Projects OS — Project Reset Only (Pure Bash — Zero Python)
set -euo pipefail

FORCE=0
if [[ "${1:-}" == "--yes" ]]; then
  FORCE=1
fi

if (( FORCE == 0 )); then
  zenity --question \
    --title="Projects OS — Project Reset" \
    --width=480 \
    --text="<b>Reset Current Project Environment?</b>\n\n<b>Will be wiped:</b>\n• Projects folder (~/Projects)\n• Installed language toolchains (Java, Rust, Go, Node, etc.)\n• LazyVim language extras\n• Firefox browsing history &amp; sessions\n\n<b>Will be preserved:</b>\n• Wi-Fi credentials &amp; network profiles\n• SSH keys (~/.ssh) &amp; Git config\n• All OS settings (themes, hotkeys, export paths)" \
    --ok-label="Reset Project Now" \
    --cancel-label="Cancel" || exit 0
fi

notify-send "Projects OS" "Resetting project workspace..." || true

CONF_FILE="$HOME/.config/projects-os/settings.conf"
PROJECTS_DIR="$HOME/Projects"
if [[ -f "$CONF_FILE" ]]; then
  CFG_DIR=$(awk -F'=' '/^\[paths\]/{p=1;next} /^\[/{p=0} p && $1=="projects_dir"{sub(/^[^=]*=/,""); print; exit}' "$CONF_FILE" || true)
  if [[ -n "$CFG_DIR" ]]; then
    PROJECTS_DIR="${CFG_DIR/#\~/$HOME}"
  fi
fi

if [[ -d "$PROJECTS_DIR" ]]; then
  rm -rf "${PROJECTS_DIR:?}"/* "${PROJECTS_DIR:?}"/.[!.]* 2>/dev/null || true
fi
mkdir -p "$PROJECTS_DIR"

rm -rf "$HOME/.local/share/mise" "$HOME/.cache/mise" "$HOME/.config/mise/config.toml"

STACK_FILE="$HOME/.local/state/projects-os/pacman-stacks.list"
if [[ -f "$STACK_FILE" ]]; then
  mapfile -t PKGS < "$STACK_FILE"
  if (( ${#PKGS[@]} > 0 )); then
    sudo pacman -Rns --noconfirm "${PKGS[@]}" 2>/dev/null || true
  fi
  rm -f "$STACK_FILE"
fi

cat > "$HOME/.config/nvim/lazyvim.json" <<'EOF'
{
  "extras": [],
  "version": 7
}
EOF
rm -rf "$HOME/.local/share/nvim/mason"

pkill -x firefox 2>/dev/null || true
for prof in "$HOME/.mozilla/firefox/"*.projects-minimal; do
  if [[ -d "$prof" ]]; then
    find "$prof" -mindepth 1 -maxdepth 1 \
      ! -name "chrome" \
      ! -name "user.js" \
      -exec rm -rf {} + 2>/dev/null || true
  fi
done
rm -rf "$HOME/.cache/mozilla"

rm -f "$HOME/.local/state/projects-os/wizard-done"
notify-send "Project Reset Complete" "Wi-Fi, SSH keys, and OS settings preserved. Starting stack picker..." || true
exec /usr/local/bin/projects-wizard

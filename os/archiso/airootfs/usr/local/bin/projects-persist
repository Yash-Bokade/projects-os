#!/usr/bin/env bash
set -euo pipefail

LABEL="PROJECTS_PERSIST"
PERSIST_MNT="/persist"
TARGET_GB=15

# Ensure 'dev' account exists and has default password 'projects'
if ! id dev >/dev/null 2>&1; then
  useradd -m -u 1000 -G wheel,video,audio,input,network,storage -s /usr/bin/bash dev
fi
echo "dev:projects" | chpasswd
echo "root:projects" | chpasswd

# Allow opting out via kernel cmdline: projects.nopersist=1
if grep -qw "projects.nopersist=1" /proc/cmdline; then
  echo "[projects-persist] Disabled via kernel cmdline (Live RAM mode)."
  mkdir -p /home/dev
  cp -an /etc/skel/. /home/dev/ || true
  chown -R 1000:1000 /home/dev
  exit 0
fi

udevadm settle --timeout=10 || true

PART_DEV=$(blkid -L "$LABEL" 2>/dev/null || true)

if [[ -z "$PART_DEV" ]]; then
  echo "[projects-persist] No $LABEL partition found. Inspecting boot USB for free space..."
  BOOT_SRC=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
  if [[ -n "$BOOT_SRC" ]]; then
    BASE_DISK=$(lsblk -no PKNAME "$BOOT_SRC" 2>/dev/null | head -n 1 || true)
    if [[ -n "$BASE_DISK" ]]; then
      DISK_PATH="/dev/${BASE_DISK}"
      REMOVABLE=$(cat "/sys/block/${BASE_DISK}/removable" 2>/dev/null || echo 0)
      echo "[projects-persist] Boot disk: $DISK_PATH (removable=$REMOVABLE)"

      # Relocate GPT backup header if GPT hybrid ISO so trailing free space is visible
      sgdisk -e "$DISK_PATH" 2>/dev/null || true
      # Calculate free space after last partition (in MiB)
      FREE_MB=$(parted -sm "$DISK_PATH" unit MiB print free 2>/dev/null | awk -F: '$5 == "free;" {gsub("MiB","",$4); last=$4} END {printf "%d", last+0}')
      LAST_END_MB=$(parted -sm "$DISK_PATH" unit MiB print free 2>/dev/null | awk -F: '$5 == "free;" {gsub("MiB","",$2); last=$2} END {printf "%d", last+0}')
      echo "[projects-persist] Detected trailing free space: ${FREE_MB} MiB starting at ${LAST_END_MB} MiB"

      if (( FREE_MB >= 4096 )); then
        WANT_MB=$(( TARGET_GB * 1024 ))
        if (( FREE_MB < WANT_MB + 512 )); then
          WANT_MB=$(( FREE_MB - 256 ))
        fi
        END_MB=$(( LAST_END_MB + WANT_MB ))
        echo "[projects-persist] Creating ${WANT_MB} MiB ext4 partition ($LABEL) on $DISK_PATH..."

        # Create partition cleanly using sfdisk (works on MBR hybrid ISO drives flashed via Rufus DD)
        echo "${LAST_END_MB}M,${WANT_MB}M,L" | sfdisk --append --no-reread --force "$DISK_PATH" || true
        partprobe "$DISK_PATH" || true
        udevadm settle --timeout=10 || true

        NEW_PART=$(lsblk -lnpo NAME,TYPE "$DISK_PATH" | awk '$2=="part"{p=$1} END{print p}')
        if [[ -n "$NEW_PART" ]]; then
          mkfs.ext4 -F -L "$LABEL" -O ^has_journal "$NEW_PART" || mkfs.ext4 -F -L "$LABEL" "$NEW_PART"
          udevadm settle --timeout=5 || true
          PART_DEV="$NEW_PART"
          echo "[projects-persist] Created persistent partition: $PART_DEV"
        fi
      else
        echo "[projects-persist] Less than 4 GiB free on $DISK_PATH; skipping auto-partition."
      fi
    fi
  fi
fi

if [[ -n "$PART_DEV" && -b "$PART_DEV" ]]; then
  mkdir -p "$PERSIST_MNT"
  mount -o defaults,noatime,nodiratime "$PART_DEV" "$PERSIST_MNT"

  # Initialize persistent tree if brand new
  mkdir -p "$PERSIST_MNT/home/dev"            "$PERSIST_MNT/etc/NetworkManager/system-connections"            "$PERSIST_MNT/var/lib/projects-os"

  if [[ ! -f "$PERSIST_MNT/home/dev/.projects-os-seeded" ]]; then
    echo "[projects-persist] Seeding initial user profile onto persistent storage..."
    cp -a /etc/skel/. "$PERSIST_MNT/home/dev/"
    touch "$PERSIST_MNT/home/dev/.projects-os-seeded"
    chown -R 1000:1000 "$PERSIST_MNT/home/dev"
  fi

  mkdir -p /home/dev /etc/NetworkManager/system-connections /var/lib/projects-os
  mount --bind "$PERSIST_MNT/home/dev" /home/dev
  mount --bind "$PERSIST_MNT/etc/NetworkManager/system-connections" /etc/NetworkManager/system-connections
  mount --bind "$PERSIST_MNT/var/lib/projects-os" /var/lib/projects-os

  chmod 700 /etc/NetworkManager/system-connections
  chown -R 1000:1000 /home/dev/.config /home/dev/.local 2>/dev/null || true
  echo "[projects-persist] Persistent storage active on $PART_DEV."
else
  echo "[projects-persist] Running in Live RAM mode (no persistent partition available)."
  mkdir -p /home/dev
  cp -an /etc/skel/. /home/dev/ || true
  chown -R 1000:1000 /home/dev
fi

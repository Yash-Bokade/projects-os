#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/projects-os"
mkdir -p "$STATE_DIR"

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  STATE_FILE="$STATE_DIR/hypr-hidden.json"
  CUR_WS=$(hyprctl activeworkspace -j | jq -r '.id')

  if [[ -f "$STATE_FILE" ]] && [[ -s "$STATE_FILE" ]]; then
    while read -r addr; do
      [[ -n "$addr" ]] && hyprctl dispatch movetoworkspacesilent "${CUR_WS},address:${addr}" >/dev/null 2>&1 || true
    done < <(jq -r '.[]' "$STATE_FILE")
    rm -f "$STATE_FILE"
    notify-send -t 1500 "Windows Restored" "All minimized windows are visible again." || true
  else
    ADDRS=$(hyprctl clients -j | jq -c --argjson ws "$CUR_WS" '[.[] | select(.workspace.id == $ws) | .address]')
    COUNT=$(echo "$ADDRS" | jq 'length')
    if (( COUNT > 0 )); then
      echo "$ADDRS" > "$STATE_FILE"
      while read -r addr; do
        [[ -n "$addr" ]] && hyprctl dispatch movetoworkspacesilent "special:minimized,address:${addr}" >/dev/null 2>&1 || true
      done < <(echo "$ADDRS" | jq -r '.[]')
      notify-send -t 1500 "Windows Hidden ($COUNT)" "Press Super+D again to restore." || true
    fi
  fi

elif [[ -n "${NIRI_SOCKET:-}" ]]; then
  STATE_FILE="$STATE_DIR/niri-prev-ws"
  if [[ -f "$STATE_FILE" ]]; then
    PREV_IDX=$(cat "$STATE_FILE")
    rm -f "$STATE_FILE"
    niri msg action focus-workspace "$PREV_IDX" >/dev/null 2>&1 || true
    notify-send -t 1500 "Windows Restored" "Returned to workspace $PREV_IDX." || true
  else
    CUR_IDX=$(niri msg -j workspaces | jq -r '.[] | select(.is_focused == true) | .idx' | head -n 1)
    EMPTY_IDX=$(niri msg -j workspaces | jq -r '[.[] | .idx] | max' | head -n 1)
    if [[ -n "$CUR_IDX" && -n "$EMPTY_IDX" ]]; then
      echo "$CUR_IDX" > "$STATE_FILE"
      niri msg action focus-workspace "$EMPTY_IDX" >/dev/null 2>&1 || true
      notify-send -t 1500 "Desktop Cleared" "Press Super+D again to return to your open windows." || true
    fi
  fi
fi

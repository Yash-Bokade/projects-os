{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "niri/workspaces"],
  "modules-center": ["cpu", "memory", "custom/storage"],
  "modules-right": ["network", "battery", "clock", "custom/settings", "custom/reset"],

  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "on-click": "/usr/local/bin/projects-toggle-sysmon"
  },
  "memory": {
    "interval": 3,
    "format": "RAM {used:0.1f}/{total:0.1f}G",
    "on-click": "/usr/local/bin/projects-toggle-sysmon"
  },
  "custom/storage": {
    "exec": "/usr/local/bin/projects-waybar-storage",
    "return-type": "json",
    "interval": 15,
    "on-click": "/usr/local/bin/projects-settings"
  },
  "network": {
    "format-wifi": "WiFi {essid}",
    "format-ethernet": "ETH {ipaddr}",
    "format-disconnected": "Offline",
    "on-click": "foot --title='Network Setup' -e nmtui"
  },
  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%"
  },
  "clock": {
    "format": "{:%H:%M  %d %b}"
  },
  "custom/settings": {
    "format": "Settings",
    "tooltip": "Projects OS Settings (Super + ,)",
    "on-click": "/usr/local/bin/projects-settings"
  },
  "custom/reset": {
    "format": "Reset",
    "tooltip": "Reset Current Project (keeps Wi-Fi, SSH & OS settings)",
    "on-click": "/usr/local/bin/projects-reset"
  }
}

# Single source of truth for the whole desktop.
# Grays + ONE primary + ONE secondary accent (Omarchy-style, amber/ember by default).
# Change a value here and niri, waybar, rofi, ghostty, eww, mako, firefox and zed all follow.
{
  wallpaper = "#1c1c1c"; # solid dark-gray wallpaper
  surface = "#141414"; # bars, popups, terminal background
  surfaceAlt = "#202020"; # inputs, cards
  border = "#3a3a3a"; # inactive window border
  fg = "#d4d4d4";
  dim = "#7a7a7a";

  primary = "#d79921"; # active border, clock hours, highlights
  secondary = "#cc4125"; # clock minutes, urgent, errors

  font = "JetBrainsMono Nerd Font";
  fontSize = 11;
  opacity = 0.85; # terminal background opacity
}
